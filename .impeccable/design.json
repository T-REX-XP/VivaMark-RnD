      "html": "<div class=\"ds-layer-row ds-layer-selected\"><button class=\"ds-layer-select\" aria-pressed=\"true\" aria-label=\"Select Your text layer\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M4 5h16M12 5v15M8 20h8\"/></svg><span>Your text<small>Text</small></span></button><label class=\"ds-layer-visible\"><input type=\"checkbox\" checked aria-label=\"Show Your text layer\"></label></div>",
      "css": ".ds-layer-row{display:flex;align-items:center;border-bottom:1px solid var(--line,#dce4dd)}.ds-layer-selected{background:#eef4e8}.ds-layer-select{display:flex;align-items:center;gap:11px;min-height:51px;padding:9px 8px;text-align:left;background:none;border:0;color:#233f36;min-width:0;flex:1;width:100%;cursor:pointer;font:13px Inter,\"Segoe UI\",Arial,sans-serif}.ds-layer-select>span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-layer-select small{display:block;font-size:11px;color:#61726b;margin-top:3px;text-transform:capitalize}.ds-layer-visible{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;cursor:pointer}.ds-layer-visible input{width:18px;height:18px;accent-color:#173c35}.ds-layer-select:focus-visible,.ds-layer-visible input:focus-visible{outline:2px solid var(--focus,#b7712a);outline-offset:4px}"
    }
