    {
      "name": "Image Upload Review",
      "kind": "custom",
      "refersTo": "upload-review",
      "description": "Single native snapshot preview with direct upload, progress/cancellation, and success on full coverage plus device completion. Readback is optional diagnostic evidence; simulation remains distinct.",
      "html": "<dialog open class=\"ds-upload\" aria-labelledby=\"ds-upload-title\"><header><h2 id=\"ds-upload-title\">Upload this image</h2><p>Synthetic badge simulator</p></header><div class=\"ds-upload-proof\"><div class=\"ds-upload-circle\" role=\"img\" aria-label=\"Decoded image preview placeholder\"></div><div><strong>Prepared artwork</strong><span>TEST.RES \u00b7 360 \u00d7 360</span><code>SHA-256 fingerprint</code></div></div><p>Simulation only. No physical badge will be changed.</p><footer><button class=\"ds-upload-close\">Close</button><button class=\"ds-upload-primary\">Simulate image upload</button></footer></dialog>",
      "css": ".ds-upload{position:relative;margin:0;width:min(600px,calc(100vw - 32px));max-height:calc(100dvh - 40px);overflow:auto;border:0;border-radius:16px;padding:28px;color:#233f36;background:#fff;box-shadow:0 18px 64px #10291f44;font:14px Inter,\"Segoe UI\",Arial,sans-serif}.ds-upload::backdrop{background:#112c2570}.ds-upload h2{font-size:23px;margin:0}.ds-upload header p{font-size:13px;color:var(--muted,#61726b);margin:9px 0 0}.ds-upload-proof{display:flex;align-items:center;gap:24px;margin:28px 0}.ds-upload-circle{width:120px;height:120px;border-radius:50%;background:var(--orange,#e9a25a);flex-shrink:0}.ds-upload-proof>div:last-child{display:flex;flex-direction:column;gap:9px;font-size:13px}.ds-upload-proof strong{font-size:17px}.ds-upload-proof code{font:11px ui-monospace,Consolas,monospace;color:#61726b}.ds-upload footer{display:flex;justify-content:flex-end;gap:10px;padding-top:19px;border-top:1px solid var(--line,#dce4dd);margin-top:22px}.ds-upload button{border:1px solid #d4ddd4;background:white;color:var(--green,#173c35);border-radius:8px;padding:10px 14px;min-height:42px;font:600 14px Inter,\"Segoe UI\",Arial,sans-serif;cursor:pointer;transition:background .16s,color .16s,border-color .16s}.ds-upload .ds-upload-primary{background:var(--green,#173c35);border-color:var(--green,#173c35);color:white}.ds-upload button:hover:not(:disabled){background:#e8eee7}.ds-upload .ds-upload-primary:hover:not(:disabled){background:#295248}.ds-upload button:disabled{opacity:.43;cursor:not-allowed}.ds-upload button:focus-visible{outline:2px solid var(--focus,#b7712a);outline-offset:4px}@media(max-width:760px){.ds-upload{padding:22px}.ds-upload-circle{width:100px;height:100px}.ds-upload-proof{gap:17px}.ds-upload h2{font-size:21px}}@media(prefers-reduced-motion:reduce){.ds-upload button{transition:none}}"
    },
